<odoo>
 
<record id="tag_action" model="ir.actions.act_window">
    <field name="name">tag list</field>
    <field name="res_model">estate.property.tag</field>
   
  
</record>

 <record id="tag_list" model="ir.ui.view">
    <field name="name">tag list</field>
    <field name="model">estate.property.tag</field>
    <field name="arch" type="xml">
    <list>
      <field name="name" readonly="True"/>
      </list>
    </field>
  </record>
<menuitem
    id="tag_menu"
    name="Properties Tags"
   parent="setting"
   action="tag_action"/>



    <record id="tag_form" model="ir.ui.view">
    <field name="name">tag form</field>
    <field name="model">estate.property.tag</field>
    <field name="arch" type="xml">
    <form>
     <sheet>
             <group >
                
             <group>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
             </group>
         
             </group>
             </sheet>

      </form>
    </field>
  </record>


</odoo>
