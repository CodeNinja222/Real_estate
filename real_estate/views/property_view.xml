<odoo>
 
<record id="property_action" model="ir.actions.act_window">
    <field name="name">properties list</field>
    <field name="res_model">real.estate.property</field>
    <field name="view_mode">list,kanban,pivot,graph,form</field>
    <field name="context">{'search_default_filter_available': 1}</field>
   
  
</record>

 <record id="property_kanban" model="ir.ui.view">
    <field name="name">estate.property.kanban</field>
    <field name="model">real.estate.property</field>
    <field name="arch" type="xml">
        <kanban default_group_by="property_type" group_create="false" group_delete="false" group_edit="false" disable_drag="1">
        
            <field name="status"/>
            <field name="best_price"/>
            <field name="selling_price"/>
            <field name="expected_price"/>
      <templates>
                <t t-name="kanban-box">
                    <div class="o_kanban_record card shadow-sm rounded p-2">
                        <div class="d-flex justify-between align-items-center mb-2">
                            <strong class="text-primary"><field name="name"/></strong>
                        </div>
                        
                        <div class="mb-1 text-muted">
                            Expected Price: <t t-esc="record.expected_price.value"/> 
                        </div>

                        <div t-if="record.status.raw_value == 'offer_received'" class="mb-1 text-warning">
                            Best Price: <t t-esc="record.best_price.value"/>
                        </div>

                        <div t-if="record.status.raw_value == 'offer_accepted'" class="mb-1 text-success">
                            Selling Price: <t t-esc="record.selling_price.value"/>
                        </div>
                     <div class="mb-1 text-muted">
                            <field name="tag_ids"/>
                        </div>
                          <div  class="mb-1 text-muted">
                           <field name="date_availability"/>
                        </div>
                       
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
 <record id="property_list" model="ir.ui.view">
        <field name="name">estate.property.lists</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list >
                    <field name="name"/>
                    <field name="description"/>
                    <field name="postcode"/>
                    <field name="garden"/>
                    <field name="garden_area"/>
                    <field name="tag_ids" widget="many2many_tags"  />
                    <field name="garden_orientation"/>
                    <field name="expected_price" optional="1"/>
                    <field name="selling_price" optional="1"/>
                    <field name="facades"/>
                    <field name="garage"/>
                    <field name="living_area"/>
                    <field name="bedrooms"/>
                    <field name="date_availability" optional="1"/>
                    <field name="owner_id" string="Owner"/>
        </list>
        </field>
    </record>
    <record id="view_estate_property_pivot" model="ir.ui.view">
    <field name="name">estate.property.pivot</field>
    <field name="model">real.estate.property</field>
    <field name="arch" type="xml">
        <pivot string="Property Pivot">
            <field name="status" type="row"/>   
            <field name="property_type" type="col"/>  
              <field name="expected_price" type="measure"/>
        </pivot>
    </field>
</record>


<record id="view_estate_property_graph" model="ir.ui.view">
    <field name="name">estate.property.graph</field>
    <field name="model">real.estate.property</field>
    <field name="arch" type="xml">
        <graph string="Property Sales Analysis" type="bar">
            <field name="name" type="row"/> 
            <field name="selling_price" type="measure"/> 
        </graph>
    </field>
</record>

<menuitem
    id="property_menu"
    name="Properties"
   parent="properties"
   action="property_action"/>







    <record id="property_form" model="ir.ui.view">
    <field name="name">property form</field>
    <field name="model">real.estate.property</field>
    <field name="arch" type="xml">
    <form>
     
          
            
                <header>
                       <field name="status" widget="statusbar" statusbar_visible="new,offer_received,sold,offer_accepted"/>
                     <button name="sold_property" type="object" string="Sold" invisible="status in ('sold')"/>
                     <button name="cancel_property" type="object" string="Canceled" invisible="status in ('sold')"/>
                      <button name="print_property_report" string="Print Report" type="object" class="btn-primary"/>

                </header>
             <sheet>

           
               <group >
                        <h1><field name="name" nolabel="1"/></h1>
                       
                        
                </group>
                
                 <field name="tag_ids" widget="many2many_tags" nolabel="1" options="{'color_field': 'color'}"/>
                 
                


                <group>
                          <group >
                            <field name="property_type" options="{'no_create': True, 'no_edit': True}" />
                            <field name="postcode"/>
                            <field name="date_availability" />
                            
                            
                    </group>
                    <group>
                        <field name="expected_price" />
                      <field name="selling_price" readonly="1" />
                      <field name="best_price" />
                    </group>
                </group>
              
             <notebook colspan="4">
              <page name="description_page" string="Description">
                <group>
                   <field name="description"/>
                   <field name="bedrooms"/>
                    <field name="living_area"/>
                     <field name="facades"/>
                     <field name="garage"/>
                     <field name="garden"/>
                     <field name="garden_area" invisible="not garden"/>
                     <field name="garden_orientation" invisible="not garden"/>
                      <field name="total_area"/>
                </group>
                 

              </page>
              <page name="offer_page" string="Offer">
                 <field name="offer_ids" >
                              
                             <list editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                                <field name="price"/>
                                <field name="partner_id"/>
                                <field name="deadline"/>
                                <field name="validity_days"/>
                                <button name="accepted_offer" type="object" string="Accept" icon="fa-check" invisible="status"/>
                                <button name="refuse_offer" type="object" string="Refuse" icon="fa-times" invisible="status" />
                                <field name="status" readonly="True"/>
                               <field name="property_type_id"/>
                                
                            </list>
                        </field>

              </page>
              <page name="other_info" string="Other Info">
                <group >
                   <field name="salesperson_id" string="Sales person"/>
                  <field name="buyer_id" readonly="True"/>
                  <field name="owner_id" string="Owner"/>
                </group>
                  
              </page>
              <page name="Details_Type" string="Details Type">
                <field name="details_ids" >
                              
                             <list editable="bottom" create="True" edit="True" delete="True" >
                                <field name="detail_id" />
                                <field name="count" />
                                 <field name="remark" />
                                
                            </list>
                        </field>
 
                 
                
                  
              </page>
             </notebook>
            
               
                 
                  </sheet> 
             
              
             

      </form>
    </field>
  </record>






   <record id="property_search" model="ir.ui.view">
    <field name="name">property search</field>
    <field name="model">real.estate.property</field>
    <field name="arch" type="xml">
   
    <search >
    <field name="name"/>
   <field name="date_availability" />
     <field name="postcode"/>
      <field name="expected_price"/>
       <field name="bedrooms"/>
       <field name="facades"/>
       <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
      
     <filter name="have_garage" string="Have a garage" domain="[('garage', '=', 'True')]"/>
     <filter name="have_a_garden" string="Have a garden" domain="[('garden', '=', 'True')]"/>
     <filter name="have_expected_price_above_200000" string="Expected Price > 200,000" domain="[('expected_price', '>', 200000)]"/>
     <filter name="garden" string="garden"  context="{'group_by': 'garden'}" />
     <filter name="postcode" string="postcode"  context="{'group_by': 'postcode'}" />
     <filter name="filter_available" string="Available" domain="[('status', '!=', 'sold')]" />
     <filter name="group_by_property_type" string="Group by type"  context="{'group_by': 'property_type'}" />
      <filter name="group_status" string="Group by status"  context="{'group_by': 'status'}" />
      <filter name="group_availability" string="Group by availability"  context="{'group_by': 'date_availability'}" />
</search>


    
    </field>
  </record>
    

</odoo>
