<odoo>
 
<record id="type_action" model="ir.actions.act_window">
    <field name="name">Type list</field>
    <field name="res_model">estate.property.type</field>
   
  
</record>
<record id="act_open_offers" model="ir.actions.act_window">
    <field name="name">Offer List</field>
    <field name="res_model">estate.property.offer</field>
    <field name="view_mode">list</field>
    <field name="domain">[('property_type_id', '=', active_id)]</field>
    
</record>

 <record id="type_list" model="ir.ui.view">
    <field name="name">type list</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
    <list>

      <field name="sequence" widget="handle"/>
      <field name="name"/>

      </list>
    </field>
  </record>
<menuitem
    id="type_menu"
    name="Properties Types"
   parent="setting"
   action="type_action"/>



    <record id="type_form" model="ir.ui.view">
    <field name="name">type form</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
        <form>
           
                <header>
                     
        <button name="%(act_open_offers)d" type="action"
                class="oe_stat_button" icon="fa-tags">
            <field name="offer_count" widget="statinfo" string="Offers"/>
        </button>
  
    
                </header>
           <sheet>
                <group>
                    <field name="name"/>
                  
                </group>

                <notebook>
                    <page name="properties_page" string="Properties">
                        <field name="property_ids">
                            <list create="false" delete="false" >
                                <field name="name"/>
                                <field name="status"/>
                                <field name="expected_price"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="offers_view" model="ir.ui.view">
         <field name="name">Offer list</field>
    <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list delete="False" create="False" edit="False" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                   
                                <field name="price"/>
                                <field name="partner_id"/>
                                <field name="deadline"/>
                                <field name="validity_days"/>
                                <button name="accepted_offer" type="object" string="Accept" icon="fa-check" invisible="status"/>
                                <button name="refuse_offer" type="object" string="Refuse" icon="fa-times" invisible="status" />
                                <field name="status" readonly="True"/>
                               <field name="property_type_id"/>
                                 </list>
              </field>   
           
            
        </record>



</odoo>
